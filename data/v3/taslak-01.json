  "hal_havuzu_ornegi": {
    "hal": "kaygili",
    "secilen": [
      {
        "ayetler": [
          "94:5",
          "94:6"
        ],
        "gerekce": "Zorluğun yalnız gelmediğini art arda iki kez söyler. Kısa, doğrudan, tek başına anlaşılır.",
        "not": ""
      },
      {
        "ayetler": [
          "2:286"
        ],
        "gerekce": "Kaygının çoğu “kaldıramayacağım” korkusudur. Ayet yükün güce göre olduğunu söyler ve bir duayla biter.",
        "not": "Uzun ayet"
      },
      {
        "ayetler": [
          "13:28"
        ],
        "gerekce": "Kalbin nerede yatışacağını söyler; kaygının tam karşılığı.",
        "not": ""
      },
      {
        "ayetler": [
          "33:3"
        ],
        "gerekce": "İki kısa cümle: dayan ve yeter. Belirsizlikte tutunacak bir söz.",
        "not": ""
      },
      {
        "ayetler": [
          "9:51"
        ],
        "gerekce": "Başa gelenin bir ölçüsü olduğunu ve sahipsiz olmadığımızı hatırlatır.",
        "not": ""
      },
      {
        "ayetler": [
          "64:11"
        ],
        "gerekce": "Hiçbir şeyin başıboş olmadığını ve inanan kalbe yön verileceğini söyler.",
        "not": ""
      },
      {
        "ayetler": [
          "10:107"
        ],
        "gerekce": "Sıkıntıyı kimin gidereceğini ve hayrın engellenemeyeceğini birlikte söyler.",
        "not": ""
      },
      {
        "ayetler": [
          "2:155",
          "2:156",
          "2:157"
        ],
        "gerekce": "Korku ve kaybın hayatın parçası olduğunu açıkça söyler, sonra sabredene müjde verir. Kaygıyı yok saymaz, yerine oturtur.",
        "not": "Üçü birlikte gösterilir"
      },
      {
        "ayetler": [
          "48:4"
        ],
        "gerekce": "Sükûnetin kalbe indirilen bir şey olduğunu söyler.",
        "not": ""
      },
      {
        "ayetler": [
          "2:186"
        ],
        "gerekce": "Yakınlık ve duaya karşılık vaadi; “kimse duymuyor” hissine cevap.",
        "not": ""
      },
      {
        "ayetler": [
          "11:123"
        ],
        "gerekce": "Bilinmeyenin sahibi bellidir ve bütün işler O'na döner; gelecek kaygısına doğrudan dokunur.",
        "not": ""
      },
      {
        "ayetler": [
          "46:13"
        ],
        "gerekce": "Korkunun ve üzüntünün kalkacağını vaat eder; kısa ve net.",
        "not": ""
      },
      {
        "ayetler": [
          "20:46"
        ],
        "gerekce": "“Ben sizinle birlikteyim, işitir ve görürüm.” Kıssada Musa ile Harun'a söylenir, anlamı geneldir.",
        "not": "Kıssa içi söz — karar sende"
      },
      {
        "ayetler": [
          "3:173"
        ],
        "gerekce": "Tehdit karşısında söylenen söz: “Allah bize yeter, O ne güzel vekildir.”",
        "not": "Bağlamı tehdit altındaki inananlar — karar sende"
      }
    ],
    "elenen": [
      {
        "ayet": "2:216",
        "neden": "İkinci cümlesi çok uygun, ama ayet savaş hükmüyle başlıyor. Ayeti kesip göstermiyoruz."
      },
      {
        "ayet": "65:2–3",
        "neden": "Çıkış yolu ve tevekkül vaadi güçlü, ama 65:2 boşanma hükmünün devamı; 65:3 ise tek başına “ona” diye başlıyor."
      },
      {
        "ayet": "39:36",
        "neden": "“Allah kuluna yeterli değil mi?” diye başlıyor, fakat devamı sapkınlıktan söz ediyor; teselli arayana ağır gelir."
      },
      {
        "ayet": "28:7",
        "neden": "Musa'nın annesine özel bir durum; genellemek zor."
      },
      {
        "ayet": "8:10",
        "neden": "Savaş bağlamı."
      },
      {
        "ayet": "3:139",
        "neden": "Kaygıdan çok moral bozukluğuna hitap ediyor. “Umudum azaldı” hâline aday."
      },
      {
        "ayet": "11:6",
        "neden": "Rızık kaygısı. “Geçim derdindeyim” hâline aday."
      },
      {
        "ayet": "57:22–23",
        "neden": "Kayıp üzerine. “Bir kaybım var” hâline aday."
      },
      {
        "ayet": "2:214",
        "neden": "“Allah'ın yardımı yakındır.” “Sabrım tükeniyor” hâline aday."
      }
    ]
  }
